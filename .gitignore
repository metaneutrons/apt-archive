# Patterns deliberately UNANCHORED, so that they bite at every level.
node_modules/
target/
dist/
build/
__pycache__/
*.pyc

# Intermediate archive state never belongs in the repository
staging/
out/
*.deb
*.asc
*.gpg
*.pgp
!contracts/*.pgp

.env
.env.*
!.env.example
*.log
.DS_Store
.idea/
.vscode/
